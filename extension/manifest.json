{
  "manifest_version": 3,
  "name": "本地 BOSS 岗位助手",
  "version": "2.0.1",
  "minimum_chrome_version": "120",
  "description": "将本人的 BOSS 网页与本地岗位助手配对，使用固定网页控件操作。",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接本地岗位助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "dom-executor.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
